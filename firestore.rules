rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Bu kurallar başlangıç taslağıdır. Canlıya almadan önce Firebase Auth
    // anonim kullanıcı kimliği ve oda sahibi doğrulamasıyla tamamlanmalıdır.
    match /rooms/{roomId} {
      allow read, write: if false;
      match /{document=**} {
        allow read, write: if false;
      }
    }
  }
}