rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function roomPath(roomId) { return /databases/$(database)/documents/rooms/$(roomId); }
    function memberPath(roomId, uid) { return /databases/$(database)/documents/rooms/$(roomId)/members/$(uid); }
    function roomExists(roomId) { return exists(roomPath(roomId)); }
    function isHost(roomId) {
      return signedIn() && roomExists(roomId) &&
        get(roomPath(roomId)).data.hostUid == request.auth.uid;
    }
    function isApproved(roomId) {
      return signedIn() && exists(memberPath(roomId, request.auth.uid)) &&
        get(memberPath(roomId, request.auth.uid)).data.status == 'approved';
    }
    function roomOpen(roomId) {
      return roomExists(roomId) && get(roomPath(roomId)).data.status == 'open';
    }

    match /rooms/{roomId} {
      allow create: if signedIn() &&
        request.resource.data.keys().hasOnly(['hostUid','status','createdAt','title']) &&
        request.resource.data.hostUid == request.auth.uid &&
        request.resource.data.status == 'open';
      allow get: if signedIn() && (isHost(roomId) || isApproved(roomId) ||
        (resource.data.status == 'open' && exists(memberPath(roomId, request.auth.uid)) &&
         get(memberPath(roomId, request.auth.uid)).data.status == 'pending'));
      allow list: if false;
      allow update: if isHost(roomId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','closedAt']) &&
        request.resource.data.status == 'closed';
      allow delete: if isHost(roomId);

      match /members/{uid} {
        allow create: if signedIn() && request.auth.uid == uid && roomOpen(roomId) &&
          request.resource.data.keys().hasOnly(['name','status','joinedAt']) &&
          request.resource.data.name is string &&
          request.resource.data.name.size() > 0 &&
          request.resource.data.name.size() <= 24 &&
          (request.resource.data.status == 'pending' ||
            (request.resource.data.status == 'approved' && isHost(roomId)));
        allow get, list: if signedIn() &&
          (request.auth.uid == uid || isHost(roomId) || isApproved(roomId));
        allow update: if signedIn() &&
          ((isHost(roomId) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','approvedAt']) &&
            request.resource.data.status in ['approved','rejected']) ||
           (request.auth.uid == uid &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSeen'])));
        allow delete: if signedIn() && (request.auth.uid == uid || isHost(roomId));
      }

      match /signals/{signalId} {
        allow create: if signedIn() && isApproved(roomId) &&
          request.resource.data.keys().hasOnly(['from','to','type','payload','createdAt']) &&
          request.resource.data.from == request.auth.uid &&
          request.resource.data.to is string &&
          request.resource.data.to != request.auth.uid &&
          request.resource.data.type in ['description','candidate'] &&
          isApproved(roomId, request.resource.data.to);
        allow get, list: if signedIn() && isApproved(roomId) &&
          (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
        allow delete: if signedIn() && isApproved(roomId) &&
          (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
        allow update: if false;
      }
    }
  }
}