rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function anonymous() {
      return request.auth != null &&
        request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function memberPath(sessionId) {
      return /databases/$(database)/documents/members/$(sessionId);
    }

    function ownSession(sessionId) {
      return anonymous() && exists(memberPath(sessionId)) &&
        get(memberPath(sessionId)).data.uid == request.auth.uid;
    }

    function validName(name) {
      return name is string && name.size() > 0 && name.size() <= 24;
    }

    match /members/{sessionId} {
      allow get, list: if anonymous();

      allow create: if anonymous() && sessionId.matches('^[A-Za-z0-9-]{8,64}$') &&
        request.resource.data.keys().hasAll(['uid', 'name', 'joinedAt', 'lastSeen', 'talking']) &&
        request.resource.data.keys().hasOnly(['uid', 'name', 'joinedAt', 'lastSeen', 'talking']) &&
        request.resource.data.uid == request.auth.uid &&
        validName(request.resource.data.name) &&
        request.resource.data.joinedAt == request.time &&
        request.resource.data.lastSeen == request.time &&
        request.resource.data.talking == false;

      allow update: if ownSession(sessionId) &&
        request.resource.data.keys().hasOnly(['uid', 'name', 'joinedAt', 'lastSeen', 'talking']) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'lastSeen', 'talking']) &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.joinedAt == resource.data.joinedAt &&
        request.resource.data.lastSeen == request.time &&
        validName(request.resource.data.name) &&
        request.resource.data.talking is bool;

      allow delete: if anonymous() && (
        resource.data.uid == request.auth.uid ||
        (resource.data.lastSeen is timestamp &&
         resource.data.lastSeen < request.time - duration.value(45, 's'))
      );

      match /inbox/{signalId} {
        allow get, list, delete: if ownSession(sessionId);

        allow create: if anonymous() &&
          request.resource.data.keys().hasAll(['fromSession', 'fromUid', 'toSession', 'kind', 'payload', 'createdAt']) &&
          request.resource.data.keys().hasOnly(['fromSession', 'fromUid', 'toSession', 'kind', 'payload', 'createdAt']) &&
          request.resource.data.fromSession is string &&
          request.resource.data.fromSession != sessionId &&
          ownSession(request.resource.data.fromSession) &&
          request.resource.data.fromUid == request.auth.uid &&
          request.resource.data.toSession == sessionId &&
          exists(memberPath(sessionId)) &&
          request.resource.data.kind in ['offer', 'answer', 'candidate'] &&
          request.resource.data.payload is string &&
          request.resource.data.payload.size() <= 12000 &&
          request.resource.data.createdAt == request.time;

        allow update: if false;
      }
    }

    match /pttTokens/{uid} {
      allow read: if false;

      allow create, update: if anonymous() && request.auth.uid == uid &&
        request.resource.data.keys().hasAll(['uid', 'sessionId', 'token', 'environment', 'updatedAt']) &&
        request.resource.data.keys().hasOnly(['uid', 'sessionId', 'token', 'environment', 'updatedAt']) &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.sessionId is string &&
        ownSession(request.resource.data.sessionId) &&
        request.resource.data.token is string &&
        request.resource.data.token.matches('^[A-Fa-f0-9]{40,512}$') &&
        request.resource.data.environment in ['sandbox', 'production'] &&
        request.resource.data.updatedAt == request.time;

      allow delete: if anonymous() && request.auth.uid == uid;
    }

    match /pushDevices/{uid} {
      allow read: if false;

      allow create, update: if anonymous() && request.auth.uid == uid &&
        request.resource.data.keys().hasAll(['uid', 'token', 'updatedAt']) &&
        request.resource.data.keys().hasOnly(['uid', 'token', 'updatedAt']) &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.token is string &&
        request.resource.data.token.size() >= 20 &&
        request.resource.data.token.size() <= 4096 &&
        request.resource.data.updatedAt == request.time;

      allow delete: if anonymous() && request.auth.uid == uid;
    }
  }
}
