rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null &&
        request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function roomPath(roomId) {
      return /databases/$(database)/documents/rooms/$(roomId);
    }

    function memberPath(roomId, uid) {
      return /databases/$(database)/documents/rooms/$(roomId)/members/$(uid);
    }

    function roomExists(roomId) {
      return exists(roomPath(roomId));
    }

    function isHost(roomId) {
      return signedIn() && roomExists(roomId) &&
        get(roomPath(roomId)).data.hostUid == request.auth.uid;
    }

    function isApproved(roomId, uid) {
      return signedIn() && exists(memberPath(roomId, uid)) &&
        get(memberPath(roomId, uid)).data.status == 'approved';
    }

    function hasActiveMembership(roomId, uid) {
      return signedIn() && exists(memberPath(roomId, uid)) &&
        get(memberPath(roomId, uid)).data.status in ['pending', 'approved'];
    }

    function roomOpen(roomId) {
      return roomExists(roomId) && get(roomPath(roomId)).data.status == 'open';
    }

    function validMemberName(name) {
      return name is string && name.size() > 0 && name.size() <= 24;
    }

    match /rooms/{roomId} {
      allow create: if signedIn() && roomId.matches('^[A-Z0-9]{12}$') &&
        request.resource.data.keys().hasAll(['hostUid', 'status', 'createdAt', 'title']) &&
        request.resource.data.keys().hasOnly(['hostUid', 'status', 'createdAt', 'title']) &&
        request.resource.data.hostUid == request.auth.uid &&
        request.resource.data.status == 'open' &&
        request.resource.data.createdAt is timestamp &&
        request.resource.data.title == 'EKİP ODASI';

      allow get: if signedIn() &&
        (resource.data.hostUid == request.auth.uid ||
         resource.data.status == 'open' ||
         hasActiveMembership(roomId, request.auth.uid));
      allow list: if false;

      allow update: if isHost(roomId) && resource.data.status == 'open' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'closedAt']) &&
        request.resource.data.status == 'closed' &&
        request.resource.data.closedAt == request.time;
      allow delete: if false;

      match /members/{uid} {
        allow create: if signedIn() && request.auth.uid == uid && roomOpen(roomId) &&
          request.resource.data.keys().hasAll(['name', 'status', 'joinedAt']) &&
          request.resource.data.keys().hasOnly(['name', 'status', 'joinedAt']) &&
          validMemberName(request.resource.data.name) &&
          request.resource.data.joinedAt is timestamp &&
          (request.resource.data.status == 'pending' ||
           (request.resource.data.status == 'approved' && isHost(roomId)));

        allow get: if signedIn() &&
          (request.auth.uid == uid || isHost(roomId) ||
           (isApproved(roomId, request.auth.uid) && resource.data.status == 'approved'));
        allow list: if signedIn() &&
          (isHost(roomId) ||
           (isApproved(roomId, request.auth.uid) && resource.data.status == 'approved'));

        // Approval and rejection run through an authenticated Cloud Function so
        // capacity checks and host verification stay on the server.
        allow update: if signedIn() && request.auth.uid == uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']) &&
          request.resource.data.status == resource.data.status &&
          validMemberName(request.resource.data.name);

        allow delete: if signedIn() && (request.auth.uid == uid || isHost(roomId));
      }
    }
  }
}
