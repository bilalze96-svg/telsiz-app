{
  "name": "telsiz-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "test:static": "node --test tests/pwa.test.js",
    "test:build": "node --test tests/build.test.js",
    "test:rules": "firebase emulators:exec --only firestore --project telsiz-app-88ecf \"node --test --test-concurrency=1 tests/firestore.rules.test.js functions/test/room-moderation.emulator.test.js\"",
    "validate": "node --check app.js && node --check functions/index.js && npm run test:static && npm run build && npm run test:build && npm run lint --prefix functions && npm test --prefix functions && npm run test:rules"
  },
  "dependencies": {
    "firebase": "13.4.0",
    "livekit-client": "2.24.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "firebase-tools": "15.37.0",
    "vite": "6.4.6"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.7"
  }
}
